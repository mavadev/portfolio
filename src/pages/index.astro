---
import Icon from '../components/Icon.astro';
import StarMark from '../components/StarMark.astro';
import Background from '../components/Background.astro';
import CopyEmailButton from '../components/CopyEmailButton.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = `${site.name} | ${site.role}`;
---

<BaseLayout
	title={pageTitle}
	description={site.seoDescription}>
	<Background />

	<main class='relative isolate flex min-h-screen items-center justify-center px-5 py-12 sm:px-8'>
		<section class='mx-auto w-full max-w-3xl text-center motion-safe:animate-enter'>
			<div class='mb-7 sm:mb-9'>
				<StarMark />
			</div>

			<div
				class='mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.035] px-3.5 py-2 text-xs font-medium tracking-wide text-zinc-300 backdrop-blur-md sm:text-sm'>
				<span class='relative flex h-2 w-2'>
					<span class='absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50'></span>
					<span class='relative inline-flex h-2 w-2 rounded-full bg-emerald-400'></span>
				</span>
				{site.status}
				<span
					class='text-zinc-600'
					aria-hidden='true'>·</span
				>
				<span>{site.location}</span>
			</div>

			<p class='mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-violet-300/80 sm:text-base text-balance'>
				{site.name} · {site.role}
			</p>

			<h1 class='text-balance text-4xl font-semibold tracking-[-0.045em] text-white sm:text-6xl lg:text-7xl'>
				{site.title}
			</h1>

			<p class='mx-auto mt-6 max-w-2xl text-pretty text-base leading-7 text-zinc-400 sm:text-lg sm:leading-8'>
				{site.description}
			</p>

			<div class='mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center'>
				<a
					href={site.github}
					target='_blank'
					rel='noreferrer'
					class='group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-zinc-950 transition duration-300 hover:-translate-y-0.5 hover:bg-violet-100 hover:shadow-[0_16px_45px_rgba(139,92,246,0.24)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-400'>
					<Icon
						name='github'
						class='h-[18px] w-[18px]'
					/>
					Ver GitHub
				</a>

				<CopyEmailButton email={site.email} />

				{
					site.cvUrl && (
						<a
							href={site.cvUrl}
							download
							class='group inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.045] px-5 py-3 text-sm font-medium text-zinc-200 backdrop-blur-sm transition duration-300 hover:border-violet-300/[0.30] hover:bg-white/[0.08] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-400'>
							<Icon
								name='download'
								class='h-[18px] w-[18px]'
							/>
							Descargar CV
						</a>
					)
				}
			</div>

			<div class='mt-10 flex items-center justify-center gap-3 text-sm text-zinc-500'>
				<span class='h-px w-8 bg-white/10'></span>
				<a
					href={`mailto:${site.email}`}
					class='rounded-sm transition hover:text-zinc-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-400'>
					{site.email}
				</a>
				<span class='h-px w-8 bg-white/10'></span>
			</div>
		</section>
	</main>

	<footer
		class='pointer-events-none fixed inset-x-0 bottom-0 px-5 pb-5 text-center text-[11px] tracking-[0.18em] text-zinc-700 uppercase sm:pb-7'>
		Diseñado y desarrollado con Astro + Tailwind CSS
	</footer>
</BaseLayout>
